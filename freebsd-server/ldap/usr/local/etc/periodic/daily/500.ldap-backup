if [ -r /etc/defaults/periodic.conf ]
then
    . /etc/defaults/periodic.conf
    source_periodic_confs
fi

case "${daily_ldap_backup_enable}" in
    [Yy][Ee][Ss])
        echo
        echo "Backing up the LDAP directory:"

        # An option is passed only if it has been configured explicitly.
        set --
        if [ -n "${daily_ldap_backup_directory}" ]
        then
            set -- "$@" --output-directory "${daily_ldap_backup_directory}"
        fi
        if [ -n "${daily_ldap_backup_generations}" ]
        then
            set -- "$@" --generations "${daily_ldap_backup_generations}"
        fi

        /opt/local/bin/ldap_backup "$@"
        return_code=$?
        ;;

    *)
        return_code=0
        ;;
esac

exit ${return_code}
