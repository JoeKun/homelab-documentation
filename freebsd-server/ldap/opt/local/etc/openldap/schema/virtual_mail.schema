# /opt/local/etc/openldap/schema/virtual_mail.schema

#-----------------------------------------------------------------------
# Schema OID
#-----------------------------------------------------------------------

objectIdentifier virtualMailSchemaOID 1.3.6.1.4.1.4203.666.49


#-----------------------------------------------------------------------
# Classes
#-----------------------------------------------------------------------

# The following object classes carry no attributes of their own.

objectClass ( virtualMailSchemaOID:102
    NAME 'virtualMailboxDomain'
    DESC 'Domain whose mail may be delivered to local mailboxes'
    SUP top AUXILIARY )

objectClass ( virtualMailSchemaOID:103
    NAME 'virtualMailAliasDomain'
    DESC 'Domain whose addresses must all resolve to an alias'
    SUP top AUXILIARY )

objectClass ( virtualMailSchemaOID:104
    NAME 'virtualMailSender'
    DESC 'Account allowed to submit authenticated mail without a local mailbox'
    SUP top AUXILIARY )

