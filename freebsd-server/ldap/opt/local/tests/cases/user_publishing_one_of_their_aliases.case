# The published address determines the canonical name for the local mailbox,
# and an entry associated with a local mailbox may publish any address it
# accepts email for, rather than only the one implied by its user identifier.
ldap_create_user --domain "my_domain.tld" --uid "my_username"   \
                 --given-name "John" --surname "Smith"          \
                 --mail-alias "john.smith"                      \
                 --mail "john.smith@my_domain.tld"              \
                 --user-password "secret"

# Expected exit status: 0
# Expected LDIF:

dn: uid=my_username,ou=users,ou=my_domain.tld,o=homelab
objectClass: top
objectClass: person
objectClass: inetOrgPerson
objectClass: inetLocalMailRecipient
uid: my_username
cn: John Smith
givenName: John
sn: Smith
userPassword: {CRYPT}$2a$12$SaltSaltSaltSaltSaltSaHashHashHashHashHashHashHashHas
mail: john.smith@my_domain.tld
mailLocalAddress: my_username@my_domain.tld
mailLocalAddress: john.smith@my_domain.tld
