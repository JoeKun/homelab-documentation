# A capability is always joined rather than created, but a group naming who may
# use an application is not: the first account to be given one brings it into
# existence. LDAP_TEST_EXISTING_ENTRIES tells the harness this one is already
# there, so this exercises the other branch.
LDAP_TEST_EXISTING_ENTRIES="cn=my_application,ou=groups,ou=system,o=homelab"    \
    ldap_create_user --system --cn "my_second_service"                          \
                     --user-password "secret"                                   \
                     --system-group "my_application"

# Expected exit status: 0
# Expected LDIF:

dn: cn=my_second_service,ou=users,ou=system,o=homelab
objectClass: top
objectClass: applicationProcess
objectClass: simpleSecurityObject
userPassword: {CRYPT}$2a$12$SaltSaltSaltSaltSaltSaHashHashHashHashHashHashHashHas
cn: my_second_service

dn: cn=service-accounts,ou=capabilities,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_second_service,ou=users,ou=system,o=homelab

dn: cn=my_application,ou=groups,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_second_service,ou=users,ou=system,o=homelab
