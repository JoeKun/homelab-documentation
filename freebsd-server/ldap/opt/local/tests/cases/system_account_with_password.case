ldap_create_user --system --cn "my_service" --user-password "secret"    \
                 --capability "user-authenticators"                     \
                 --capability "group-membership-readers"

# Expected exit status: 0
# Expected LDIF:

dn: cn=my_service,ou=users,ou=system,o=homelab
objectClass: top
objectClass: applicationProcess
objectClass: simpleSecurityObject
userPassword: {CRYPT}$2a$12$SaltSaltSaltSaltSaltSaHashHashHashHashHashHashHashHas
cn: my_service

dn: cn=service-accounts,ou=capabilities,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_service,ou=users,ou=system,o=homelab

dn: cn=user-authenticators,ou=capabilities,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_service,ou=users,ou=system,o=homelab

dn: cn=group-membership-readers,ou=capabilities,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_service,ou=users,ou=system,o=homelab
