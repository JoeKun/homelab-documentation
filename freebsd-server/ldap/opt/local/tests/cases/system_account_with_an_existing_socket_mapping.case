# Re-running a setup script should not be an error, and the server refuses a
# duplicate value outright, so an existing mapping is left alone rather than
# added again. LDAP_TEST_EXISTING_SOCKET_MAPPINGS tells the harness this entry
# is already mapped, so nothing is written to cn=config below.
LDAP_TEST_EXISTING_SOCKET_MAPPINGS="cn=my_mail_service,ou=users,ou=system,o=homelab"    \
    ldap_create_user --system --cn "my_mail_service"                                    \
                     --socket-account "my_mail_service"

# Expected exit status: 0
# Expected LDIF:

dn: cn=my_mail_service,ou=users,ou=system,o=homelab
objectClass: top
objectClass: applicationProcess
cn: my_mail_service

dn: cn=service-accounts,ou=capabilities,ou=system,o=homelab
changetype: modify
add: member
member: cn=my_mail_service,ou=users,ou=system,o=homelab
