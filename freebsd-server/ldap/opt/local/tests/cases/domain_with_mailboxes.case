ldap_create_domain --domain "my_domain.tld" --mailbox-domain

# Expected exit status: 0
# Expected LDIF:

dn: ou=my_domain.tld,o=homelab
objectClass: top
objectClass: organizationalUnit
objectClass: domainRelatedObject
objectClass: virtualMailboxDomain
ou: my_domain.tld
associatedDomain: my_domain.tld

dn: ou=users,ou=my_domain.tld,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: users

dn: ou=groups,ou=my_domain.tld,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: groups
