# The suffix is an organization rather than a domain, since several domains are
# served here and no one of them owns the directory.
ldap_create_top_level_directory_and_system_entries --administrator-password "secret"

# Expected exit status: 0
# Expected LDIF:

dn: o=homelab
objectClass: top
objectClass: organization
o: homelab

dn: ou=system,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: system

dn: ou=users,ou=system,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: users

dn: ou=groups,ou=system,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: groups

dn: ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: organizationalUnit
ou: capabilities

dn: cn=admin,ou=users,ou=system,o=homelab
objectClass: top
objectClass: applicationProcess
objectClass: simpleSecurityObject
cn: admin
description: LDAP directory administrator
userPassword: {CRYPT}$2a$12$SaltSaltSaltSaltSaltSaHashHashHashHashHashHashHashHas

dn: cn=service-accounts,ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
cn: service-accounts
description: Accounts allowed to read the structural attributes every client needs
member: cn=admin,ou=users,ou=system,o=homelab

dn: cn=user-authenticators,ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
cn: user-authenticators
description: Accounts allowed to read user identifiers for authentication purposes
member: cn=admin,ou=users,ou=system,o=homelab

dn: cn=mail-routing-readers,ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
cn: mail-routing-readers
description: Accounts allowed to read which addresses exist and where their mail goes
member: cn=admin,ou=users,ou=system,o=homelab

dn: cn=group-membership-readers,ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
cn: group-membership-readers
description: Accounts allowed to read group membership and the names groups are imported under
member: cn=admin,ou=users,ou=system,o=homelab

dn: cn=user-profile-readers,ou=capabilities,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
cn: user-profile-readers
description: Accounts allowed to read the personal details an application displays
member: cn=admin,ou=users,ou=system,o=homelab
