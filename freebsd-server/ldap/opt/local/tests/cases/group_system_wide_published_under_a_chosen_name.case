# Providing a display name publishes the group too, since there would be no
# other reason to choose one: the attribute exists for the applications that
# import groups, and only published groups can be imported by applications.
ldap_create_group --system --cn "my_application-admins"             \
                  --display-name "administrators_of_my_application" \
                  --member "uid=my_username,ou=users,ou=my_domain.tld,o=homelab"

# Expected exit status: 0
# Expected LDIF:

dn: cn=my_application-admins,ou=groups,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
objectClass: publishedGroup
cn: my_application-admins
displayName: administrators_of_my_application
member: uid=my_username,ou=users,ou=my_domain.tld,o=homelab
