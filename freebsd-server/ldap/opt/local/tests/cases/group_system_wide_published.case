# The other kind of system group: one naming a role inside an application
# rather than gating access to it.
#
# For example, an application cannot be told that this group means its
# administrators unless it has imported the group first, so this one is
# published and carries the marker class.
#
# There is only one group of this name in the directory, so the display
# name needs no qualification and --published is enough on its own.
ldap_create_group --system --cn "my_application-admins" --published \
                  --member "uid=my_username,ou=users,ou=my_domain.tld,o=homelab"

# Expected exit status: 0
# Expected LDIF:

dn: cn=my_application-admins,ou=groups,ou=system,o=homelab
objectClass: top
objectClass: groupOfNames
objectClass: publishedGroup
cn: my_application-admins
displayName: my_application-admins
member: uid=my_username,ou=users,ou=my_domain.tld,o=homelab
